{
  "name": "metagraph",
  "version": "0.0.7",
  "type": "module",
  "license": "MIT",
  "copyright": "2019",
  "description": "A framework for building higher-order graph data structures",
  "keywords": [
    "graph",
    "network"
  ],
  "homepage": "http://gordonwoodhull.github.io/metagraph.js",
  "bugs": "https://github.com/gordonwoodhull/metagraph.js/issues",
  "author": {
    "name": "Gordon Woodhull",
    "url": "http://gordon.woodhull.com/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gordonwoodhull/metagraph.js.git"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.44.1",
    "typescript": "^5.8.3",
    "vitest": "^1.6.1"
  },
  "scripts": {
    "build": "rollup -c",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "rollup -c --watch"
  },
  "npmName": "metagraph",
  "main": "dist/metagraph.js",
  "module": "dist/metagraph.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "npmFileMap": [
    {
      "basePath": "/",
      "files": [
        "dist/metagraph.min.js",
        "dist/metagraph.min.js.map",
        "dist/metagraph.js",
        "dist/metagraph.js.map",
        "dist/metagraph.esm.js",
        "dist/metagraph.esm.js.map"
      ]
    }
  ]
}
