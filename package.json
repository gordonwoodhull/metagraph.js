{
  "name": "metagraph",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "copyright": "2019",
  "description": "A framework for building higher-order graph data structures",
  "keywords": [
    "graph",
    "network"
  ],
  "homepage": "http://gordonwoodhull.github.io/metagraph.js",
  "bugs": "https://github.com/gordonwoodhull/metagraph.js/issues",
  "author": {
    "name": "Gordon Woodhull",
    "url": "http://gordon.woodhull.com/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gordonwoodhull/metagraph.js.git"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.44.1",
    "tsx": "^4.20.6",
    "typedoc": "^0.28.6",
    "typescript": "^5.8.3",
    "vitest": "^1.6.1"
  },
  "scripts": {
    "build": "rollup -c",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "rollup -c --watch",
    "docs": "typedoc src/index.ts",
    "docs:serve": "typedoc src/index.ts --watch"
  },
  "main": "dist/metagraph.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/metagraph.js",
      "types": "./dist/esm/index.d.ts"
    }
  },
  "files": [
    "dist/"
  ]
}
